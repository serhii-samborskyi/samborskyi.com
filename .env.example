# Required Coolify runtime variables. Keep both unavailable during image build.
DATABASE_URL=postgresql://user:password@postgres-host:5432/samborskyi
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters

# Coolify's Domain setting supplies COOLIFY_URL/COOLIFY_FQDN automatically.
# All configured domains are accepted. The first is used in links and social previews.
# To override a generated preview address, or outside Coolify, set the public URL:
# APP_URL=https://samborskyi.com
# PORT=3000

# Optional integrations: configure only the services you use.
# Email through a verified Resend sender:
# RESEND_API_KEY=
# EMAIL_FROM=Serhii Samborskyi <music@your-domain.com>
# Telegram through a bot created with @BotFather:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# Meta Pixel (public numeric ID; only loads with marketing consent):
# META_PIXEL_ID=

# Session, Telegram webhook, and VAPID secrets are generated and saved in the DB.
# Optional overrides for an existing installation:
# SESSION_SECRET=
# TELEGRAM_WEBHOOK_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@your-domain.com
# ADMIN_PASSWORD_HASH=

# SQLite alternative (requires persistent storage mounted at /app/data):
# DATABASE_URL=file:/app/data/studio.sqlite
# DATA_DIR=/app/data
# Set only behind a trusted proxy that replaces X-Forwarded-For:
# TRUST_PROXY=1
